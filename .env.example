# —— 复制为 .env 后填写；.env 已进 .gitignore，禁止提交真实值 ——

# 后端 REST 基址（services/api/client.ts 读取；仅此层允许读 API env — 07 §3 规则 5）
#
# ⚠️ 正常情况**留空**。空串 = 走同源相对路径 `/api/*`，由 next.config.ts 的 rewrites
#    转给后端。这是唯一在真浏览器里跑得通的配法：后端没有 CORS（preflight 404、
#    响应无 Access-Control-*），任何跨源 origin 都会被浏览器拦下，表现是「网络错误」。
#    只有当你确实要让浏览器跨源直连（并且已经给后端配好 CORS）时才填绝对地址。
NEXT_PUBLIC_API_BASE_URL=

# rewrites 的转发目标（Node 侧读取，**不进客户端 bundle**，故没有 NEXT_PUBLIC_ 前缀）。
# 后端不在默认位置时改这里。
API_ORIGIN=http://127.0.0.1:3001

# 终端 PTY / events WebSocket 网关基址（containers/workbench 读取）
#
# ⚠️ 这一条**必须是绝对地址**，与上面那条不同——rewrites 只处理 HTTP，不代理 upgrade。
#
# ⚠️ **host 必须与你在浏览器地址栏里用的 host 逐字一致**（端口可以不同）。
#    `ap_session` 是 host-only cookie（Set-Cookie 不带 Domain），而 cookie 只认 host、
#    不区分端口。地址栏是 localhost 就写 ws://localhost:<后端端口>；写成 127.0.0.1
#    就是另一个 host，cookie 带不过去，WS 握手会被拒然后无限重连
#    （后端日志：events handshake rejected: missing/invalid access passcode）。
#    localhost 与 127.0.0.1 指向同一台机器，但对 cookie 而言是两个 host。
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3001

# 后端 dev server 暴露的 openapi.json（scripts/watch-openapi 与 generate:api 远程模式可用）
# OPENAPI_URL=http://localhost:3001/openapi.json
